# ============================================================
# WellPeps Pulse environment variables
# Copy to .env and fill in what you use:  cp .env.example .env
# Never commit .env (it is gitignored). Every key is optional.
# ============================================================

# Claude API key for API mode (prototype runs on the Claude subscription via
# `claude -p`; switch to a WellPeps key before launch).
ANTHROPIC_API_KEY=

# Slack incoming webhook for urgent/escalation alerts (link + category only).
SLACK_WEBHOOK_URL=

# Apify token for public-data collectors (later phase; pending legal sign-off).
APIFY_TOKEN=

# Meta Graph API token for reading owned Instagram/Facebook channels (later phase).
META_ACCESS_TOKEN=

# First dashboard admin account (later phase: auth).
PULSE_ADMIN_EMAIL=
PULSE_ADMIN_PASSWORD=
