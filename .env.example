# ============================================================
# WellPeps Pulse environment variables
# Copy to .env and fill in what you use:  cp .env.example .env
# Never commit .env (it is gitignored). Every key is optional.
# ============================================================

# Claude API key for API mode (prototype runs on the Claude subscription via
# `claude -p`; switch to a WellPeps key before launch).
ANTHROPIC_API_KEY=

# Slack incoming webhook for urgent/escalation alerts (link + category only).
SLACK_WEBHOOK_URL=

# Apify token for public-data collectors (later phase; pending legal sign-off).
APIFY_TOKEN=

# Meta Graph API token for reading owned Instagram/Facebook channels (later phase).
META_ACCESS_TOKEN=

# First dashboard admin, created on `pulse dashboard` start only while the
# users table is empty (password min 12 chars). Remove after first start;
# add more users with `pulse user add`.
PULSE_ADMIN_EMAIL=
PULSE_ADMIN_PASSWORD=

# Postgres (Supabase project wellpeps-pulse, schema `pulse`) instead of SQLite.
# Leave blank to use SQLite (data/pulse.db, or PULSE_DB_PATH). When set, every
# pulse command uses Postgres; apply db/postgres/*.sql first. Get the URI from
# Supabase -> Connect -> Session pooler and append ?sslmode=require. It holds
# the database password: keep it in .env only, never commit it.
# See db/postgres/README.md.
# PULSE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
